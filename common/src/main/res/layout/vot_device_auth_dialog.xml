<?xml version="1.0" encoding="utf-8"?>
<!--
    Диалог авторизации Яндекс ID по Device Code Flow.
    Оптимизирован для Android TV: крупный шрифт, D-pad навигация, focusable кнопки.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Шаг 1: Инструкция -->
    <TextView
        android:id="@+id/vot_device_instruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/dialog_text_color"
        android:textSize="16sp" />

    <!-- URL -->
    <TextView
        android:id="@+id/vot_device_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:textColor="@color/dialog_text_color"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Крупный user_code -->
    <TextView
        android:id="@+id/vot_device_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@color/white_20"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/dialog_text_color"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <!-- Таймер обратного отсчёта -->
    <TextView
        android:id="@+id/vot_device_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textColor="@color/white_50"
        android:textSize="14sp" />

    <!-- Статус (ожидание / ошибка / успех) -->
    <TextView
        android:id="@+id/vot_device_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:textColor="@color/dialog_text_color"
        android:textSize="14sp" />

    <!-- Кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/vot_device_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/vot_device_auth_refresh" />

        <Button
            android:id="@+id/vot_device_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:text="@string/vot_device_auth_cancel" />

    </LinearLayout>

</LinearLayout>
