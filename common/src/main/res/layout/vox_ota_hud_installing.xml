<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vox_ota_installing_root"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_vox_ota_card"
    android:padding="28dp">

    <!-- Top Row: Icon + Header + Close Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Stage Badge Icon -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_vox_ota_icon_blue">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_vox_ota_gear"
                android:contentDescription="Settings" />
        </FrameLayout>

        <!-- Titles Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vox_ota_installing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Установка обновления"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/vox_ota_installing_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="SmartTube Vox - 9.1"
                android:textColor="#E0E6ED"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Пожалуйста, не выключайте устройство"
                android:textColor="#8E9DAE"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Top-Right Close Button -->
        <ImageButton
            android:id="@+id/vox_ota_btn_close_installing"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_vox_ota_btn_icon"
            android:src="@drawable/ic_vox_ota_close"
            android:scaleType="centerInside"
            android:focusable="true"
            android:contentDescription="Закрыть" />
    </LinearLayout>

    <!-- Progress Bar & Percentage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/vox_ota_install_progressbar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:progressDrawable="@drawable/bg_vox_ota_progressbar"
            android:max="100"
            android:progress="35" />

        <TextView
            android:id="@+id/vox_ota_install_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="35%"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Steps Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="vertical">

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/vox_ota_step1_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_vox_ota_dot_active"
                android:contentDescription="Step 1" />

            <TextView
                android:id="@+id/vox_ota_step1_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Подготовка..."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/vox_ota_step2_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_vox_ota_dot_pending"
                android:contentDescription="Step 2" />

            <TextView
                android:id="@+id/vox_ota_step2_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Установка..."
                android:textColor="#CBD5E1"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/vox_ota_step3_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_vox_ota_dot_pending"
                android:contentDescription="Step 3" />

            <TextView
                android:id="@+id/vox_ota_step3_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Завершение..."
                android:textColor="#8E9DAE"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
