<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vox_download_overlay_root"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_vox_download_overlay"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:elevation="12dp"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:clickable="false">

    <!-- Header line: Spinner/Icon + Stage Title + Queue Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/vox_download_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:indeterminate="true"
            android:indeterminateTint="@color/vox_accent" />

        <ImageView
            android:id="@+id/vox_download_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/vox_download_stage_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="@color/vox_text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/vox_download_queue_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_vox_queue_badge"
            android:textColor="@color/vox_accent"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Details line: Progress / Size & ETA -->
    <LinearLayout
        android:id="@+id/vox_download_details_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/vox_download_progress_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/vox_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/vox_download_eta_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/vox_accent"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/vox_download_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:progressDrawable="@drawable/vox_download_progressbar"
        android:max="100"
        android:progress="0" />

</LinearLayout>
