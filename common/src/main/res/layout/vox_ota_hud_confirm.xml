<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vox_ota_confirm_root"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_vox_ota_card"
    android:padding="28dp">

    <!-- Top Row: Icon + Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Badge Icon -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_vox_ota_icon_blue">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_vox_ota_arrow_down"
                android:contentDescription="Download Icon" />
        </FrameLayout>

        <!-- Titles Column -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vox_ota_confirm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Загрузить обновление?"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/vox_ota_confirm_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="SmartTube Vox - 9.1"
                android:textColor="#E0E6ED"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/vox_ota_confirm_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Размер файла: 368 МБ"
                android:textColor="#8E9DAE"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Wi-Fi Recommendation Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_vox_ota_btn_secondary"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_vox_ota_wifi"
            android:contentDescription="Wi-Fi" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Рекомендуется Wi‑Fi"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Примерное время: 1–2 мин"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="(в зависимости от скорости)"
                android:textColor="#8E9DAE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions: [ Загрузить ] [ Отмена ] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/vox_ota_btn_download"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_vox_ota_btn_primary"
            android:text="Загрузить"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:focusable="true"
            android:nextFocusRight="@+id/vox_ota_btn_cancel" />

        <Space
            android:layout_width="14dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/vox_ota_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_vox_ota_btn_secondary"
            android:text="Отмена"
            android:textColor="#E0E6ED"
            android:textSize="15sp"
            android:focusable="true"
            android:nextFocusLeft="@+id/vox_ota_btn_download" />
    </LinearLayout>
</LinearLayout>
