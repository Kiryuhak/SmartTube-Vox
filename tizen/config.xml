<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://kiryuhak.github.io/SmartTubeVoxTizen"
        version="7.0.0"
        viewmodes="maximized">
    <tizen:application id="VoxTizenApp.SmartTubeVox" package="VoxTizenApp" exec="src/index.html" screen-orientation="landscape" required_version="3.0"/>
    <name>SmartTube VOX</name>
    <description>SmartTube VOX for Samsung Tizen OS TV</description>
    <author href="https://github.com/Kiryuhak/SmartTube-Vox">SmartTube VOX Team</author>
    <icon src="src/icon.png"/>
    <content src="src/index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/tv"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto"/>
    <tizen:profile name="tv"/>
</widget>
