<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:tools="http://schemas.android.com/tools"
       xmlns:android="http://schemas.android.com/apk/res/android"
       xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Changes to original image style: style="?attr/imageCardViewImageStyle" -->
    <!-- Change 1: width and height set to match_parent to fix image black borders -->
    <!-- Change 2: layout_viewType attr is moved out to parent container -->
    <ImageView
        android:id="@+id/main_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        tools:ignore="ContentDescription"/>
    <FrameLayout
        android:visibility="gone"
        android:id="@+id/preview_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Top-left badges row (width managed by ComplexImageView). -->
    <LinearLayout
        android:id="@+id/top_badges_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:padding="@dimen/vox_card_badge_margin"
        tools:ignore="RtlHardcoded">

        <!-- Translation / download marker sits at top-left. -->
        <ImageView
            android:visibility="gone"
            android:id="@+id/local_badge_icon"
            android:background="@drawable/badge_rounded_bg"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:padding="3dp"
            android:elevation="4dp"
            android:src="@drawable/action_download"
            android:tint="@color/white"
            tools:ignore="ContentDescription" />

        <Space
            android:id="@+id/top_badges_gap"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <!-- Quality badge -->
        <TextView
            android:visibility="gone"
            android:id="@+id/quality_badge"
            android:background="@drawable/badge_rounded_bg"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/vox_card_badge_padding_horizontal"
            android:paddingEnd="@dimen/vox_card_badge_padding_horizontal"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textSize="@dimen/vox_badge_text_size_quality"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:elevation="4dp"
            style="@style/TextAppearance.Leanback.ImageCardView.Content" />
    </LinearLayout>

    <!-- Bottom Badges Row & Progress (Explicit width managed by ComplexImageView) -->
    <LinearLayout
        android:id="@+id/clip_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        tools:ignore="RtlHardcoded" >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            tools:ignore="RtlHardcoded">

            <!-- Age Badge: Bottom-Left -->
            <TextView
                android:visibility="gone"
                android:id="@+id/age_badge"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/vox_card_badge_margin"
                android:layout_marginLeft="@dimen/vox_card_badge_margin"
                android:layout_marginBottom="2dp"
                android:background="@drawable/badge_rounded_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/vox_card_badge_padding_horizontal"
                android:paddingEnd="@dimen/vox_card_badge_padding_horizontal"
                android:paddingTop="@dimen/vox_card_badge_padding_vertical"
                android:paddingBottom="@dimen/vox_card_badge_padding_vertical"
                android:textSize="@dimen/vox_badge_text_size_age"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:elevation="4dp"
                style="@style/TextAppearance.Leanback.ImageCardView.Content" />

            <!-- Duration / Status Badge: Bottom-Right -->
            <TextView
                android:visibility="invisible"
                android:id="@+id/extra_text_badge"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/vox_card_badge_margin"
                android:layout_marginRight="@dimen/vox_card_badge_margin"
                android:layout_marginBottom="2dp"
                android:background="@drawable/badge_rounded_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/vox_card_badge_padding_horizontal"
                android:paddingEnd="@dimen/vox_card_badge_padding_horizontal"
                android:paddingTop="@dimen/vox_card_badge_padding_vertical"
                android:paddingBottom="@dimen/vox_card_badge_padding_vertical"
                android:textSize="@dimen/vox_badge_text_size_duration"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:elevation="4dp"
                style="@style/TextAppearance.Leanback.ImageCardView.Content" />
        </RelativeLayout>

        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.styled.CardProgressBar
            android:id="@+id/clip_progress"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lb_basic_card_info_badge_margin"
            android:max="100"
            android:progress="45"/>
    </LinearLayout>
</merge>
