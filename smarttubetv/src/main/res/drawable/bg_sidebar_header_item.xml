<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused item: High contrast bright rounded capsule with distinct border for 2-4m TV viewing -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vox_focus_radius" />
            <solid android:color="#38FFFFFF" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <!-- Selected but unfocused (active section in Leanback): very subtle, dim pill, NO border -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vox_focus_radius" />
            <solid android:color="#0DFFFFFF" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vox_focus_radius" />
            <solid android:color="#0DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
