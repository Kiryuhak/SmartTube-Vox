<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Мягкая подложка без контура; яркость текста задаёт presenter темы. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vox_focus_radius" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
    <!-- Selected but unfocused (active section in Leanback): very subtle, dim pill, NO border -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vox_focus_radius" />
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vox_focus_radius" />
            <solid android:color="#0DFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
