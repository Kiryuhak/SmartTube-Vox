<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- VOX Dialog Style (AppDialog override for Reset, Yandex ID, Token Edit, etc.) -->
    <style name="AppDialog" parent="AppDialogBase">
        <item name="android:windowBackground">@drawable/vox_dialog_window_bg</item>
        <item name="android:textColor">@color/vox_text_primary</item>
        <item name="android:textColorPrimary">@color/vox_text_primary</item>
        <item name="android:textColorSecondary">@color/vox_text_secondary</item>
        <item name="colorAccent">@color/vox_accent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/vox_accent</item>
        <item name="colorControlActivated">@color/vox_accent</item>
        <item name="android:colorControlActivated" tools:targetApi="21">@color/vox_accent</item>
        <item name="buttonBarNeutralButtonStyle">@style/VoxAppDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/VoxAppDialogButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/VoxAppDialogButtonStyle</item>
    </style>

    <style name="VoxAppDialogButtonStyle" parent="AppDialogButtonStyle">
        <item name="android:textColor">@color/vox_button_text_color</item>
        <item name="android:background">@drawable/vox_dialog_button_bg</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/vox_button_min_height</item>
        <item name="android:minWidth">80dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- VOX Nested Settings Preferences Theme -->
    <style name="App.Theme.Leanback.Preferences.Base" parent="Theme.Leanback">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Leanback</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/vox_accent</item>
        <item name="android:colorPrimary" tools:targetApi="21">@color/vox_panel</item>
        <item name="colorAccent">@color/vox_accent</item>
        <item name="colorControlActivated">@color/vox_accent</item>
        <item name="android:colorControlActivated" tools:targetApi="21">@color/vox_accent</item>
        <item name="android:selectableItemBackground">@drawable/vox_preference_item_bg</item>
        <item name="selectableItemBackground">@drawable/vox_preference_item_bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="App.Theme.Leanback.Preferences" parent="App.Theme.Leanback.Preferences.Base" />

    <style name="App.Theme.Leanback.Preferences.Opaque" parent="App.Theme.Leanback.Preferences.Base">
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="App.Theme.Leanback.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="android:windowBackground">@color/vox_bg</item>
        <item name="shelfBackground">@color/vox_bg</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/vox_accent</item>
        <item name="colorAccent">@color/vox_accent</item>
        <item name="colorControlActivated">@color/vox_accent</item>
        <item name="android:colorControlActivated" tools:targetApi="21">@color/vox_accent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
    </style>

</resources>
