<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vox_accent_glow" />
            <stroke android:width="1.5dp" android:color="@color/vox_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#E61A2230" />
            <stroke android:width="1dp" android:color="@color/vox_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC10141E" />
            <stroke android:width="1dp" android:color="#1A232B3E" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
