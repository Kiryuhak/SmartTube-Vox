<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: sleek rounded pill with soft blue highlight and border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/vox_accent_glow" />
            <stroke
                android:width="1.5dp"
                android:color="@color/vox_accent" />
        </shape>
    </item>
    <!-- Selected: active section when focus moved into content -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/vox_panel" />
            <stroke
                android:width="1dp"
                android:color="@color/vox_stroke" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
