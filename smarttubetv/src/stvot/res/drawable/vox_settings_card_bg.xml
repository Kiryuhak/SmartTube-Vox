<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: soft blue tint + vibrant blue border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/vox_accent_glow" />
            <stroke
                android:width="2dp"
                android:color="@color/vox_accent" />
        </shape>
    </item>
    <!-- Normal state: dark graphite panel with subtle stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/vox_panel" />
            <stroke
                android:width="1dp"
                android:color="@color/vox_stroke" />
        </shape>
    </item>
</selector>
