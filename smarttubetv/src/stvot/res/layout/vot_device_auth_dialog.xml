<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartTube VOX — Диалог авторизации Яндекс ID по коду устройства (Device Code Flow).
    Оптимизирован для Android TV: тёмная графитовая карточка, крупный код, D-pad навигация.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Шаг 1: Инструкция -->
    <TextView
        android:id="@+id/vot_device_instruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="@color/vox_text_secondary"
        android:textSize="15sp" />

    <!-- URL: ya.ru/device -->
    <TextView
        android:id="@+id/vot_device_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:textColor="@color/vox_accent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Крупный user_code в аккуратной карточке VOX -->
    <TextView
        android:id="@+id/vot_device_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/vox_device_code_bg"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/vox_text_primary"
        android:textSize="38sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <!-- Таймер обратного отсчёта -->
    <TextView
        android:id="@+id/vot_device_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textColor="@color/vox_accent"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Статус (ожидание / ошибка) -->
    <TextView
        android:id="@+id/vot_device_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:textColor="@color/vox_text_secondary"
        android:textSize="14sp" />

    <!-- Кнопки управления -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/vot_device_refresh"
            android:layout_width="0dp"
            android:layout_height="@dimen/vox_button_min_height"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/vox_dialog_button_bg"
            android:textColor="@color/vox_button_text_color"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/vot_device_auth_refresh" />

        <Button
            android:id="@+id/vot_device_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/vox_button_min_height"
            android:layout_weight="1"
            android:background="@drawable/vox_dialog_button_bg"
            android:textColor="@color/vox_button_text_color"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/vot_device_auth_cancel" />

    </LinearLayout>

</LinearLayout>
