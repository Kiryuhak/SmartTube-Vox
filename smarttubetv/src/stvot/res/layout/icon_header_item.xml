<?xml version="1.0" encoding="utf-8"?>
<!-- SmartTube VOX Modern Sidebar Navigation Item -->
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/vox_sidebar_item_bg"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:paddingStart="12dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/header_icon" />

    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
        android:id="@+id/header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_gravity="center_vertical"
        android:singleLine="true"
        android:maxWidth="160sp"
        android:textSize="15sp"
        android:textColor="@color/vox_sidebar_text_color"
        android:marqueeRepeatLimit="marquee_forever"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"
        style="@style/TextAppearance.Leanback.Header" />
</androidx.leanback.widget.NonOverlappingLinearLayout>
