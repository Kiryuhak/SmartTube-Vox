<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartTube VOX — Индикатор состояния закадрового перевода поверх видео (Motion UI 2.0).
    Включает крупную горизонтальную плашку (первые ~4.5 сек) с последующим плавным сжатием (collapse)
    в компактный круглый индикатор с песочными часами или реальным процентом готовности.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vot_progress_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:clickable="false">

    <!-- Expanded Pill Mode (initial ~4.5 seconds) -->
    <LinearLayout
        android:id="@+id/vot_progress_expanded_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_vot_progress_overlay"
        android:paddingStart="16dp"
        android:paddingEnd="18dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:elevation="8dp">

        <ProgressBar
            android:id="@+id/vot_progress_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical"
            android:indeterminate="true"
            android:indeterminateTint="@color/vox_accent" />

        <ImageView
            android:id="@+id/vot_progress_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/vot_progress_text_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vot_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/vox_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true" />

            <TextView
                android:id="@+id/vot_progress_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/vox_text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/vot_progress_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="14dp"
            android:textColor="@color/vox_accent"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

    </LinearLayout>

    <!-- Compact Circle Mode (post-collapse: hourglass or real % progress) -->
    <FrameLayout
        android:id="@+id/vot_progress_compact_container"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|bottom"
        android:background="@drawable/bg_vot_progress_circle"
        android:elevation="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/vot_progress_compact_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/vox_accent" />

        <ImageView
            android:id="@+id/vot_progress_compact_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_vot_hourglass"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/vot_progress_compact_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/vox_accent"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            android:singleLine="true" />

    </FrameLayout>

</FrameLayout>
