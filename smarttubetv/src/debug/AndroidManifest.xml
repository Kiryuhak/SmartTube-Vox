<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Internal developer-only test receiver for isolated Yandex VOT backend verification (debug only) -->
        <receiver
            android:name="com.liskovsoft.smartyoutubetv2.tv.vot.YandexVotTestReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.liskovsoft.smartyoutubetv2.TEST_YANDEX_VOT" />
            </intent-filter>
        </receiver>

        <!-- Internal developer-only Android View showcase activity (debug only, absent in release) -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.showcase.VoxUiShowcaseActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="com.liskovsoft.smartyoutubetv2.VOX_SHOWCASE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
